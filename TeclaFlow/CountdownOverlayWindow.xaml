<Window x:Class="TeclaFlow.CountdownOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="118" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" Focusable="False" IsHitTestVisible="False">
    <Border Margin="12" CornerRadius="20" Background="#F2171D31" BorderBrush="#55635BFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.28" Color="#10162A"/>
        </Border.Effect>
        <Grid Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>

            <Grid Width="52" Height="52" VerticalAlignment="Center">
                <Ellipse Stroke="#776DFF" StrokeThickness="3"/>
                <Ellipse Width="8" Height="8" Fill="#58E2FF"/>
                <Rectangle Width="2" Height="30" Fill="White" RadiusX="1" RadiusY="1"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                <TextBlock Text="La escritura está por comenzar" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Haz clic en el punto de la ventana donde debe aparecer el primer carácter. Se usará el cursor de texto activo."
                           Foreground="#CCD2E6" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="17"/>
            </StackPanel>

            <Border Grid.Column="2" Width="60" Height="60" CornerRadius="18" Background="#635BFF" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CountdownText" Text="5" Foreground="White" FontSize="25" FontWeight="Bold"
                               HorizontalAlignment="Center" LineHeight="27"/>
                    <TextBlock Text="seg" Foreground="#DBD9FF" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
