<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TeclaFlow</AssemblyName>
    <RootNamespace>TeclaFlow</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>TeclaFlow</Product>
    <Company>Christopher Hernandez</Company>
    <Description>Aplicación de escritorio para escritura asistida carácter por carácter.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\teclaflow.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\teclaflow-icon.png" />
    <Content Include="Assets\teclaflow.ico" />
  </ItemGroup>
</Project>
